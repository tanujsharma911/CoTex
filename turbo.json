{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "MONGODB_URL",
    "CORS_ORIGINS",
    "REDIS_URL",
    "VITE_EDITOR_URL",
    "VITE_API_URL",
    "EDITOR_PORT",
    "API_PORT",
    "MINIO_BUCKET",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_URL",
    "VITE_FRONTEND_PORT",
    "TOKEN_SECRET",
    "TOKEN_EXPIRY"
  ],
  "tasks": {
    "build": { "outputs": ["dist/**"] },
    "start": {
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
